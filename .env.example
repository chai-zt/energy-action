# Energy Action Community — 服务端环境变量
# 复制为 .env 并填入真实值（.env 已在 .gitignore 中）

# 服务器端口
PORT=4001

# MiMo API Key（BYOK，用户自行提供；仅服务端读取，绝不进入前端/数据库/Git）
MIMO_API_KEY=

# MiMo Base URL（optional，默认 pay-as-you-go OpenAI-compatible endpoint）
# Token Plan 用户可改成自己的 Base URL
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# MiMo 模型（optional，默认 mimo-v2.5，可改为 mimo-v2.5-pro）
MIMO_MODEL=mimo-v2.5
PERSONAL_AI_OS_MODE=local

# Optional local AI egress proxy. Set these in the shell that starts the backend
# and use `npm run dev:server:proxy` (Node 22.21+ / Node 24+).
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
